# Ozvolt CRM — Environment variables
# Kopieer dit bestand naar .env.local voor lokaal testen
# In productie: stel in via Vercel Dashboard > Settings > Environment Variables

# Database (Neon)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Admin login
ADMIN_USER=admin
ADMIN_PASS=jouw-wachtwoord                  # plaintext (simpel)
ADMIN_PASS_HASH=                            # OF bcrypt hash (veiliger, laat ADMIN_PASS leeg)

# Sessie
SESSION_SECRET=willekeurige-string-van-minimaal-32-tekens

# SMTP (uitgaande mail)
SMTP_HOST=mail.jouwdomein.nl
SMTP_PORT=587
SMTP_USER=info@jouwdomein.nl
SMTP_PASS=jouw-smtp-wachtwoord
SMTP_FROM_NAME=Jouw Bedrijfsnaam

# Site URL (voor akkoord-links in offertes)
SITE_URL=https://crm.jouwdomein.nl

# Moneybird (Moneybird → Instellingen → Ontwikkelaars → Nieuwe API-token)
# Fiscale module (/fiscaal) leest verkoopfacturen, documenten en grootboekrekeningen;
# Bonnen-controle (/bonnen) heeft ook schrijfrechten op documenten nodig (categorie aanpassen na akkoord)
MONEYBIRD_API_TOKEN=
MONEYBIRD_ADMIN_ID=                         # het getal in de URL: moneybird.com/<ADMIN_ID>/...
MONEYBIRD_INBOX_EMAIL=                      # optioneel: inbox-mailadres van Moneybird (wordt getoond op /bonnen)

# Betalen: directe overschrijving naar de zakelijke ABN AMRO-rekening (binnen seconden binnen).
# Verplicht: zonder BEDRIJF_IBAN worden IBAN en betaal-QR niet getoond (er is bewust geen standaardnummer).
BEDRIJF_IBAN=NL00ABNA0123456789
BEDRIJF_BIC=ABNANL2A                       # standaard ABNANL2A
BETAAL_IDEAL=uit                           # 'aan' = ook iDEAL via Moneybird tonen (uitbetaling ± 2 werkdagen)

# Tikkie Zakelijk (ABN AMRO Tikkie API v2) — per (deel)factuur een Tikkie-betaallink
# API-key: developer.abnamro.com (app aanmaken); app-token: Tikkie Zakelijk → Instellingen → Ontwikkelaars
# Zonder deze twee werkt alles gewoon met alleen IBAN/QR.
TIKKIE_API_KEY=
TIKKIE_APP_TOKEN=
TIKKIE_OMGEVING=productie                  # 'sandbox' of 'productie' (standaard productie)

# Optioneel
ANTHROPIC_API_KEY=sk-ant-...                # Mail AI + AI-controle van bonnen
OPENAI_API_KEY=sk-...
MOLLIE_API_KEY=live_...
